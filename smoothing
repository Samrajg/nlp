text = "social media analytics helps detect trends"
words = text.split()
print("\nUnigram:")
for w in set(words):
    print(w, ":", (words.count(w)+1)/(len(words)+len(set(words))))
print("\nBigram:")
bigrams = list(zip(words, words[1:]))
for b in set(bigrams):
    print(b, ":", (bigrams.count(b)+1)/(len(bigrams)+len(set(words))))
print("\nTrigram:")
trigrams = list(zip(words, words[1:], words[2:]))
for t in set(trigrams):
    print(t, ":", (trigrams.count(t)+1)/(len(trigrams)+len(set(words))))
